{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "noEmit": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "types": ["bun", "node"]
  },
  "include": ["src", "test"]
}
