{
  "name": "pi-litellm-provider",
  "version": "0.6.0",
  "description": "Pi extension that auto-discovers providers, protocols, models and reasoning variants from a LiteLLM proxy",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpchen/pi-litellm-provider.git"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "bun scripts/run-with-core.ts tsc --noEmit",
    "test": "bun scripts/run-with-core.ts bun test",
    "build:dist": "bun scripts/build.ts",
    "verify:dist": "bun scripts/verify-dist.ts",
    "test:package": "bun scripts/test-package.ts",
    "validate:spec": "openspec validate --all --strict --no-interactive",
    "test:scenario-coverage": "node scripts/check-scenario-coverage.mjs",
    "test:openspec-closure": "node --test scripts/check-openspec-closure.test.mjs && node scripts/check-openspec-closure.mjs",
    "test:release-metadata": "node scripts/check-release-metadata.mjs",
    "test:e2e:pi": "node scripts/e2e-real-pi.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@fission-ai/openspec": "1.13.2",
    "@types/bun": "1.3.14",
    "@types/node": "24.4.0",
    "typescript": "5.8.2"
  }
}
